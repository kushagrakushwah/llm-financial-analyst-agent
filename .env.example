# Environment Configuration Template for Financial Analyst Agent
PORT=8001
HOST=0.0.0.0

# LLM Reasoning Configuration
# Set to 'true' for fast deterministic mock responses without GPU
# Set to 'false' to load full Qwen2.5-7B-Instruct weights
USE_MOCK_LLM=true
MODEL_PATH=Qwen/Qwen2.5-7B-Instruct

# GLiNER Extractor Configuration
GLINER_MODEL=models/gliner_financial
GLINER_THRESHOLD=0.45

# Maximum allowed document length in characters (default: 500,000)
MAX_DOCUMENT_LENGTH=500000
